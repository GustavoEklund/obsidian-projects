    "inputSchema": {
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "description": "Column id or name. Default: the first column.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["task", "story", "bug", "epic"]
        },
        "priority": {
          "type": "string",
