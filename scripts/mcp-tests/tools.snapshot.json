        },
        "assignee": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "due": {
          "description": "`YYYY-MM-DD`, `today`, `tomorrow`, `+3d` or `+2w`.",
          "type": "string"
        },
        "estimate": {
          "type": "number"
        },
        "parent": {
          "description": "Parent (epic) key.",
          "type": "string"
        },
        "body": {
          "description": "Description, in Markdown. `- [ ]` makes a checklist.",
          "type": "string"
        }
      },
      "type": "object"
    },
