{
  "name": "obsidian-projects",
  "version": "0.1.0",
  "private": true,
  "license": "Unlicense",
  "description": "A.I. first project management in real time: Jira-style cards for Obsidian, with a CLI and an MCP-ready core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoEklund/obsidian-projects.git"
  },
  "bugs": {
    "url": "https://github.com/GustavoEklund/obsidian-projects/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "node scripts/ui-test.mjs",
    "test:obsidian": "node scripts/e2e-obsidian.mjs",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:mcp-binary": "vitest run --config vitest.mcp.config.mts",
    "check:language": "tsx scripts/quality/language.ts",
    "check:docs": "tsx scripts/quality/docs.ts",
    "check:bundle": "tsx scripts/quality/bundle.ts",
    "version:check": "tsx scripts/release.ts check",
    "conformance": "tsx scripts/conformance/run.ts",
    "conformance:check": "tsx scripts/conformance/run.ts --check",
    "audit:deps": "npm audit --omit=dev --audit-level=low",
    "gates:static": "npm run lint && npm run format:check && npm run typecheck && npm run check:language && npm run check:docs && npm run version:check && npm run conformance:check",
    "check": "npm run gates:static && npm run test:coverage && npm run build && npm run check:bundle && npm run test:smoke && npm run test:ui",
    "check:mcp": "npm run lint -w packages/mcp && npm run format:check -w packages/mcp && npm run test -w packages/mcp && npm run build -w packages/mcp && npm run test:mcp-binary && npm run check:mcp-perf",
    "check:mcp-perf": "tsx scripts/quality/mcp-perf.ts",
    "check:all": "npm run check && npm run check:mcp",
    "release": "tsx scripts/release.ts",
    "seed": "tsx scripts/seed.ts",
    "install:vault": "node scripts/install-plugin.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "fast-check": "4.10.2",
    "jsdom": "^29.1.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
